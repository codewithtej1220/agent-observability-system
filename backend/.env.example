# Copy to backend/.env. All settings are optional for local development.

# development | production
AOBS_ENVIRONMENT=development

# SQLite by default. For PostgreSQL:
# AOBS_DATABASE_URL=postgresql://aobs:aobs@localhost:5432/aobs

# Encrypts stored provider API keys. Required in production; in development a key is
# generated in backend/data/secret.key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the new key first, old keys after it, comma-separated.
# AOBS_SECRET_KEY=

# Set true when the dashboard is served over HTTPS.
AOBS_COOKIE_SECURE=false

# Dashboard URL (Google sign-in redirect, links in alerts) and the URL apps use for the gateway.
AOBS_PUBLIC_URL=http://localhost:5173
AOBS_API_PUBLIC_URL=http://127.0.0.1:8000

# Google sign-in (optional). Authorized redirect URI: {AOBS_PUBLIC_URL}/api/auth/google/callback
# AOBS_GOOGLE_CLIENT_ID=
# AOBS_GOOGLE_CLIENT_SECRET=

# Email alerts (optional)
# AOBS_SMTP_HOST=smtp.example.com
# AOBS_SMTP_PORT=587
# AOBS_SMTP_USER=
# AOBS_SMTP_PASSWORD=
# AOBS_SMTP_FROM=alerts@example.com

# Development-only API key mapped to the Demo workspace (ignored in production).
AOBS_DEV_API_KEY=dev-local-key

# Origins allowed to call the API from a browser.
AOBS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Retrain the agent-failure classifier after this many new human labels (0 = manual only).
AOBS_AUTO_RETRAIN_EVERY=50

# Background jobs (window alerts, drift tests, retention). Enable in exactly one process.
AOBS_BACKGROUND_JOBS=true
