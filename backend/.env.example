# Copy to backend/.env. All settings are optional; defaults work for local development.

# development | production
AOBS_ENVIRONMENT=development

# SQLite by default. For PostgreSQL:
# AOBS_DATABASE_URL=postgresql://aobs:aobs@localhost:5432/aobs

# Comma-separated API keys accepted in the X-API-Key header (agents and dashboard).
# Change this before exposing the API anywhere.
AOBS_API_KEYS=dev-local-key

# Origins allowed to call the API from a browser.
AOBS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Retrain the classifier automatically after this many new human labels (0 = manual only).
AOBS_AUTO_RETRAIN_EVERY=50
